# Trading 212 DEMO/PRACTICE credentials only. Never commit real values.
TRADING212_API_KEY=
TRADING212_API_SECRET=

# Execution is fail-closed unless this is exactly "true" and every policy variable validates.
TRADING212_EXECUTION_ENABLED=false
TRADING212_ALLOWED_TICKERS=
TRADING212_COMPANY_BY_TICKER=
TRADING212_MAX_QUOTE_TO_ACCOUNT_RATES=USD=1.25,EUR=1
TRADING212_EXPECTED_ACCOUNT_CURRENCY=EUR
TRADING212_MAX_ABS_QUANTITY=1
TRADING212_MAX_DAILY_MUTATIONS=10
TRADING212_MAX_OPEN_ORDERS=5
TRADING212_EXECUTION_STATE_DIR=

# Optional controlled demo smoke-test inputs.
TRADING212_SMOKE_RUN_ID=
TRADING212_SMOKE_TICKER=
TRADING212_SMOKE_QUANTITY=
TRADING212_SMOKE_LIMIT_PRICE=
TRADING212_SMOKE_REFERENCE_PRICE=
TRADING212_SMOKE_REFERENCE_OBSERVED_AT=
